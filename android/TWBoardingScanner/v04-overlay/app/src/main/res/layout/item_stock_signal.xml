<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" app:cardBackgroundColor="#101A2A" app:cardCornerRadius="15dp" app:strokeWidth="1dp" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EBF1FA" android:textStyle="bold" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" />
                <TextView android:id="@+id/codeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#EBF1FA" android:textStyle="bold" android:textSize="17sp" />
                <TextView android:id="@+id/sector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#94A4B9" />
                <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="23sp" />
            </LinearLayout>
            <com.rex.twboardingscanner.ui.ScoreRingView android:id="@+id/scoreRing" android:layout_width="62dp" android:layout_height="62dp" />
        </LinearLayout>
        <TextView android:id="@+id/mainForceCost" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="估算主力成本（近20日）· 待計算" android:textSize="15sp"
            android:textStyle="bold" android:textColor="#6FDAEB" android:layout_marginTop="7dp" />
        <TextView android:id="@+id/mainForceCostNote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="成交量加權推算，並非真正大戶持股成本" android:textSize="10sp"
            android:textColor="#94A4B9" android:layout_marginTop="2dp" />
        <com.rex.twboardingscanner.ui.MiniStockChartView android:id="@+id/chartView" android:layout_width="match_parent" android:layout_height="204dp" android:layout_marginTop="5dp" />
        <TextView android:id="@+id/volumeSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6FDAEB" android:textSize="12sp" android:textStyle="bold" android:paddingTop="5dp" android:paddingBottom="3dp" />
        <LinearLayout android:id="@+id/recentVolumes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp" />
        <com.rex.twboardingscanner.ui.ClosingAuctionView android:id="@+id/closingAuction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/dEvidence" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:textColor="#89E1CE" android:textSize="12sp"
            android:background="#162A33" android:padding="10dp" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/trigger" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="#B7C4D6" android:textSize="12sp" />
        <com.rex.twboardingscanner.ui.FinancialPanelView android:id="@+id/financialPanel" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/financialButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="財務查核  ·  EPS 趨勢與明細  ›" android:textSize="12sp" android:textColor="#6FDAEB" app:backgroundTint="#142031" app:strokeColor="#243346" app:strokeWidth="1dp" app:cornerRadius="12dp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/indicatorChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="4dp" app:chipSpacingVertical="2dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
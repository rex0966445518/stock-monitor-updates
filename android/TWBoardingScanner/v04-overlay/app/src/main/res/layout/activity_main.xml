<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:clipChildren="false" android:clipToPadding="false"
    android:background="@drawable/radar_background">

    <!-- The real scanner and list remain on this page; this is not a screenshot overlay. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="5dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:padding="5dp" android:scaleType="fitCenter"
            android:src="@drawable/neon_diamond_mark"
            android:background="@drawable/neon_panel"
            android:contentDescription="AI-離職神器 紫色霓虹鑽石標誌"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AI-離職神器 · 主掃描工作台" android:textSize="17sp"
                android:singleLine="true" android:ellipsize="end"
                android:textColor="#F8F3FF" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/versionText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="量化訊號 · 真實市場數據" android:textColor="#C4AEEB" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:id="@+id/changelogButton" android:layout_width="68dp"
            android:layout_height="40dp" android:gravity="center" android:text="日誌 ›"
            android:textColor="#E4C5FF" android:textSize="10sp"
            android:includeFontPadding="false" android:singleLine="true"
            android:background="@drawable/neon_panel"
            android:clickable="true" android:focusable="true"
            android:contentDescription="查看版本日誌"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" app:cardBackgroundColor="#231047"
        app:cardCornerRadius="18dp" app:strokeColor="#B443FF"
        app:strokeWidth="1dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="9dp">
            <TextView android:id="@+id/progressTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="◉ 即時掃描進度 · 尚未開始掃描"
                android:fontFamily="sans-serif-medium" android:textSize="14sp"
                android:textColor="#F8F3FF" android:maxLines="2"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/scanProgress" android:layout_width="match_parent"
                android:layout_height="5dp" android:layout_marginTop="6dp"
                android:layout_marginBottom="5dp" app:indicatorColor="#B443FF"
                app:trackColor="#43216A" app:trackCornerRadius="3dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView android:id="@+id/progressCount" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="尚無掃描數據" android:textColor="#F8F3FF" android:textSize="11sp"
                    android:maxLines="2"/>
                <TextView android:id="@+id/etaText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="5dp"
                    android:text="待命中" android:textColor="#53E3BA" android:textSize="10sp"
                    android:maxWidth="148dp" android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="5dp" android:gravity="center">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:text="已掃描" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="10sp"
                        android:textColor="#D0B6ED"/>
                    <TextView android:id="@+id/scanScannedMetric" android:text="—"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#F8F3FF"
                        android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:text="符合條件" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="10sp"
                        android:textColor="#D0B6ED"/>
                    <TextView android:id="@+id/scanMatchedMetric" android:text="—"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#53E3BA"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:text="待查核" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="10sp"
                        android:textColor="#D0B6ED"/>
                    <TextView android:id="@+id/scanPendingMetric" android:text="—"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#AFA0FF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:text="失敗" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="10sp"
                        android:textColor="#D0B6ED"/>
                    <TextView android:id="@+id/scanFailedMetric" android:text="—"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#FF609C"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/progressStats" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="掃描詳細狀態將顯示在這裡"
                android:textColor="#C4AEEB" android:textSize="10sp" android:maxLines="2"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/startScanButton"
            style="@style/Widget.Scanner.Primary" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="40dp"
            android:layout_marginHorizontal="2dp" android:text="開始掃描"
            android:minHeight="0dp" android:textSize="11sp" android:paddingHorizontal="2dp"
            android:paddingVertical="0dp" app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/settingsButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="40dp"
            android:layout_marginHorizontal="2dp" android:text="✣ 條件與工具"
            android:minHeight="0dp" android:textSize="11sp" android:paddingHorizontal="2dp"
            android:paddingVertical="0dp" app:cornerRadius="12dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/paperButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:text="模擬交易"
            android:minHeight="0dp" android:textSize="11sp" android:paddingHorizontal="2dp"
            app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/backtestButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:text="歷史回測"
            android:minHeight="0dp" android:textSize="11sp" android:paddingHorizontal="2dp"
            app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/robotButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:text="測試機器人"
            android:minHeight="0dp" android:textSize="11sp" android:paddingHorizontal="2dp"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/marketGuardButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_weight="1.3"
            android:layout_height="37dp" android:layout_marginHorizontal="2dp"
            android:text="大盤保護 · 確認中" android:textColor="#F2B65D"
            android:minHeight="0dp" android:textSize="10sp" android:paddingHorizontal="2dp"
            app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/logButton"
            style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="37dp" android:layout_marginHorizontal="2dp"
            android:text="掃描資料夾" android:minHeight="0dp" android:textSize="10sp"
            android:paddingHorizontal="2dp" app:cornerRadius="12dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginTop="5dp"
        android:layout_marginBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="▥  掃描結果"
            android:textColor="#F8F3FF" android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="A–G · 綜合評分排序" android:textColor="#C4AEEB" android:textSize="9sp"/>
    </LinearLayout>
    <com.rex.twboardingscanner.ui.ResultFilterBar android:id="@+id/resultFilters"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipChildren="false">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="10dp"/>
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:padding="15dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="◈ 等待市場訊號" android:textSize="18sp" android:textColor="#E9D4FF"
                android:gravity="center" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="開始掃描後，實際選股結果會在此顯示。"
                android:textSize="12sp" android:textColor="#C4AEEB"
                android:gravity="center" android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Persistent navigation; click handlers are wired to existing activities. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="3dp" android:background="@drawable/neon_panel">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌂ 首頁"
            android:textColor="#C4AEEB" android:textSize="11sp" android:singleLine="true" android:includeFontPadding="false"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navScan" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="◎ 掃描"
            android:textColor="#EBCBFF" android:textStyle="bold" android:textSize="11sp" android:singleLine="true" android:includeFontPadding="false"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navBacktest" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▥ 回測"
            android:textColor="#C4AEEB" android:textSize="11sp" android:singleLine="true" android:includeFontPadding="false"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navRobot" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="◇ 機器人"
            android:textColor="#C4AEEB" android:textSize="11sp" android:singleLine="true" android:includeFontPadding="false"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navUpdate" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="↻ 更新"
            android:textColor="#C4AEEB" android:textSize="11sp" android:singleLine="true" android:includeFontPadding="false"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
<LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="入場條件" android:textSize="17sp" android:textColor="#EBF1FA" android:layout_marginBottom="10dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/conditionAButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="A 準備起漲" /><com.google.android.material.button.MaterialButton android:id="@+id/conditionBButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="B 深跌反轉" /><com.google.android.material.button.MaterialButton android:id="@+id/conditionCButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="C 突發爆量" /><com.google.android.material.button.MaterialButton android:id="@+id/conditionDButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="D 主力進場" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/scanConditionButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="產業篩選" /><com.google.android.material.button.MaterialButton android:id="@+id/searchButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="搜尋股票" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下車賣出" android:textSize="17sp" android:textColor="#EBF1FA" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/exitRulesButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="下車賣出條件 · 0 / 5 組" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="管理與紀錄" android:textSize="17sp" android:textColor="#EBF1FA" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/banButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="禁股名單" /><com.google.android.material.button.MaterialButton android:id="@+id/limitButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="限價名單" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/refreshButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="導出海報" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/updateButton" style="@style/Widget.Scanner.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="軟件更新" /></LinearLayout></LinearLayout></LinearLayout>
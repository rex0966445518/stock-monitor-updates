<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#061321">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="台股上車掃描器" android:textColor="#F7FBFF" android:textStyle="bold" android:textSize="25sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v0.4" android:textColor="#8398AD" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI 找出符合 A / B / C 條件的股票" android:textColor="#819AB3" android:layout_marginBottom="6dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="搜尋股號">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="搜尋" />
    </LinearLayout>

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="準備掃描上市櫃…" android:textColor="#D7E7F5" android:paddingTop="6dp" android:paddingBottom="6dp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#0B2034" app:cardCornerRadius="14dp" app:strokeColor="#1F66A6" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/progressTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全市場掃描中" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/scanProgress" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" app:indicatorColor="#FF496C" app:trackColor="#183B5A" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/progressCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="已掃描 0 / 0 檔" android:textColor="#C7D9EA" />
                <TextView android:id="@+id/etaText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="預估時間 --" android:textColor="#FF8AA0" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="7dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/sectorChipGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true" android:paddingTop="2dp" android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/industryFilterButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="產業篩選" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="日曆日誌" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refreshButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="重新掃描" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabMode="scrollable" app:tabTextColor="#8FA7BE" app:tabSelectedTextColor="#FF5C78" app:tabIndicatorColor="#FF496C" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>

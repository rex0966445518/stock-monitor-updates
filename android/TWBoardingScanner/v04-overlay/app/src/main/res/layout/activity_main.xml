<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/radar_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="AI-離職神器" android:textSize="17sp" android:textStyle="bold" android:textColor="#68E6CA" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:id="@+id/versionText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#87A6C1" android:textSize="11sp" />
        <TextView android:id="@+id/changelogButton" android:layout_width="80dp" android:layout_height="match_parent" android:gravity="center" android:text="優化日誌 ›" android:textColor="#4DD2FA" android:textSize="12sp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/searchButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="搜尋股票" android:textSize="11sp" app:backgroundTint="#173B56" app:strokeColor="#3386B7" app:strokeWidth="1dp" app:cornerRadius="14dp" android:textColor="#D9EFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/banButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="禁股名單" android:textSize="11sp" app:backgroundTint="#102E49" app:strokeColor="#FF537D" app:strokeWidth="1dp" app:cornerRadius="12dp" android:textColor="#FF537D" />
        <com.google.android.material.button.MaterialButton android:id="@+id/limitButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="限價名單" android:textSize="11sp" app:backgroundTint="#102E49" app:strokeColor="#FFBC5B" app:strokeWidth="1dp" app:cornerRadius="12dp" android:textColor="#FFBC5B" />
        <com.google.android.material.button.MaterialButton android:id="@+id/updateButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="一鍵更新" android:textSize="12sp" app:backgroundTint="#102E49" app:strokeColor="#4DD2FA" app:strokeWidth="1dp" app:cornerRadius="14dp" android:textColor="#4DD2FA" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.button.MaterialButton android:id="@+id/conditionAButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:text="A 掃描條件" android:textSize="12sp" android:textColor="#FF5278" app:backgroundTint="#102E49" app:strokeColor="#FF5278" app:strokeWidth="1dp" app:cornerRadius="12dp" /><com.google.android.material.button.MaterialButton android:id="@+id/conditionBButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:text="B 掃描條件" android:textSize="12sp" android:textColor="#FFBF57" app:backgroundTint="#102E49" app:strokeColor="#FFBF57" app:strokeWidth="1dp" app:cornerRadius="12dp" /><com.google.android.material.button.MaterialButton android:id="@+id/conditionCButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:text="C 掃描條件" android:textSize="12sp" android:textColor="#42BBFF" app:backgroundTint="#102E49" app:strokeColor="#42BBFF" app:strokeWidth="1dp" app:cornerRadius="12dp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/scanConditionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="產業篩選" app:backgroundTint="#102E49" app:strokeColor="#3386B7" app:strokeWidth="1dp" app:cornerRadius="12dp" android:textColor="#D9EFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="日曆日誌" app:backgroundTint="#102E49" app:strokeColor="#3386B7" app:strokeWidth="1dp" app:cornerRadius="12dp" android:textColor="#D9EFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refreshButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="導出海報" app:backgroundTint="#102E49" app:strokeColor="#3386B7" app:strokeWidth="1dp" app:cornerRadius="12dp" android:textColor="#D9EFFF" />
    </LinearLayout>


    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/startScanButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="6dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="開始掃描" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF537D" app:backgroundTint="#3C203A" app:strokeColor="#FF537D" app:strokeWidth="1dp" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/paperButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:text="自買自投" android:textSize="13sp" android:textStyle="bold" android:textColor="#68E6CA" app:backgroundTint="#103A3D" app:strokeColor="#35958A" app:strokeWidth="1dp" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backtestButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingHorizontal="4dp" android:text="歷史回測" android:textSize="13sp" android:textStyle="bold" android:textColor="#C3A6FF" app:backgroundTint="#232B45" app:strokeColor="#7561AB" app:strokeWidth="1dp" app:cornerRadius="14dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#0B2034" app:cardCornerRadius="14dp" app:strokeColor="#1F66A6" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/progressTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全市場掃描" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/scanProgress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" app:indicatorColor="#FF496C" app:trackColor="#183B5A" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/progressCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:text="已處理 0 / 0 檔" android:textColor="#C7D9EA" />
                <TextView android:id="@+id/etaText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:text="預估時間 --" android:textColor="#FF8AA0" />
            </LinearLayout>
            <TextView android:id="@+id/progressStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="已分析 0｜排除 0｜資料不足 0｜失敗 0" android:textColor="#8FAAC3" android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.rex.twboardingscanner.ui.ResultFilterBar android:id="@+id/resultFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>
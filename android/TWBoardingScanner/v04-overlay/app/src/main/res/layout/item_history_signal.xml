<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp" app:cardBackgroundColor="#101A2A" app:cardCornerRadius="20dp" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/badge" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="A" android:textColor="#EBF1FA" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/codeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EBF1FA" android:textStyle="bold" android:textSize="18sp" />
                <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A4B9" android:textSize="12sp" />
                <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="17sp" />
            </LinearLayout>
            <com.rex.twboardingscanner.ui.ScoreRingView android:id="@+id/scoreRing" android:layout_width="78dp" android:layout_height="78dp" />
        </LinearLayout>
        <com.rex.twboardingscanner.ui.MiniStockChartView android:id="@+id/chartView" android:layout_width="match_parent" android:layout_height="245dp" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/volumeSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6FDAEB" android:textSize="14sp" android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="6dp" />
        <LinearLayout android:id="@+id/recentVolumes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/indicatorChips" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="4dp" />
        <com.rex.twboardingscanner.ui.ClosingAuctionView android:id="@+id/closingAuction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/reasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B7C4D6" android:textSize="12sp" android:paddingTop="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>